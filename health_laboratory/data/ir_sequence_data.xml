<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_health_lab_order" model="ir.sequence">
            <field name="name">Laboratory Order Reference</field>
            <field name="code">health.lab.order</field>
            <field name="prefix">LAB/%(range_year)s%(range_month)s/</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="use_date_range">True</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_health_lab_specimen" model="ir.sequence">
            <field name="name">Laboratory Specimen Barcode Reference</field>
            <field name="code">health.lab.specimen</field>
            <field name="prefix"/>
            <field name="padding">6</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
