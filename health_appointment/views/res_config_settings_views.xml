<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_health_appointment" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.health.appointment</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="70"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Healthcare" string="Healthcare" name="health_appointment">
                    <block title="Konfigurasi Antrean Poliklinik" id="health_appointment_queue_block">
                        <setting string="Strategi Penomoran Antrean" help="Pilih strategi penomoran tiket antrean rawat jalan (per poli, per dokter, atau global)">
                            <field name="health_queue_strategy"/>
                            <div class="mt-2" invisible="health_queue_strategy != 'custom'">
                                <label for="health_queue_custom_prefix" string="Custom Prefix Template"/>
                                <field name="health_queue_custom_prefix"/>
                            </div>
                        </setting>
                        <setting string="Audio Synthesizer Pemanggil Antrean" help="Otomatis aktifkan suara panggilan pasien pada layar TV digital (/health/queue/display)">
                            <field name="health_queue_auto_call_audio"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_health_appointment_config_settings" model="ir.actions.act_window">
        <field name="name">Pengaturan Antrean</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module': 'health_appointment'}</field>
    </record>
</odoo>
