<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Schedule List View -->
    <record id="view_health_physician_schedule_list" model="ir.ui.view">
        <field name="name">health.physician.schedule.list</field>
        <field name="model">health.physician.schedule</field>
        <field name="arch" type="xml">
            <list string="Jadwal Praktik Dokter" sample="1">
                <field name="physician_id"/>
                <field name="department_id"/>
                <field name="day_of_week"/>
                <field name="start_hour" widget="float_time"/>
                <field name="end_hour" widget="float_time"/>
                <field name="max_quota"/>
                <field name="active" widget="boolean_toggle"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Schedule Form View -->
    <record id="view_health_physician_schedule_form" model="ir.ui.view">
        <field name="name">health.physician.schedule.form</field>
        <field name="model">health.physician.schedule</field>
        <field name="arch" type="xml">
            <form string="Jadwal Praktik Dokter">
                <sheet>
                    <div class="oe_title">
                        <label for="physician_id" string="Dokter / Tenaga Medis"/>
                        <h1>
                            <field name="physician_id" placeholder="Pilih Dokter..."/>
                        </h1>
                    </div>
                    <group>
                        <group string="Poliklinik &amp; Hari">
                            <field name="department_id"/>
                            <field name="day_of_week"/>
                            <field name="active"/>
                        </group>
                        <group string="Jam Praktik &amp; Kuota">
                            <field name="start_hour" widget="float_time"/>
                            <field name="end_hour" widget="float_time"/>
                            <field name="max_quota"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Schedule Action -->
    <record id="action_health_physician_schedule" model="ir.actions.act_window">
        <field name="name">Jadwal Praktik Dokter</field>
        <field name="res_model">health.physician.schedule</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Buat jadwal praktik dokter dan kuota antrean pasien per poliklinik.
            </p>
        </field>
    </record>
</odoo>
