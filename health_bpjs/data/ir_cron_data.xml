<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="cron_health_bpjs_outbox_retry" model="ir.cron">
            <field name="name">BPJS PCare Outbox Auto-Retry</field>
            <field name="model_id" ref="model_health_bpjs_kunjungan"/>
            <field name="state">code</field>
            <field name="code">
records = model.search([('state', '=', 'pending')], limit=20)
for r in records:
    r.action_send_to_pcare()
            </field>
            <field name="interval_number">10</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
