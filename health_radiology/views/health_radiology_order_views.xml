<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Radiology Order Kanban View -->
    <record id="view_health_radiology_order_kanban" model="ir.ui.view">
        <field name="name">health.radiology.order.kanban</field>
        <field name="model">health.radiology.order</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" sample="1" quick_create="false">
                <field name="id"/>
                <field name="name"/>
                <field name="patient_id"/>
                <field name="test_id"/>
                <field name="modality"/>
                <field name="priority"/>
                <field name="state"/>
                <field name="date"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click p-2">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <strong class="fs-6 text-primary"><field name="name"/></strong>
                                <field name="priority" widget="badge"
                                       decoration-danger="priority == 'cito'"
                                       decoration-info="priority == 'normal'"/>
                            </div>
                            <div class="my-1">
                                <i class="fa fa-user me-1" title="Pasien"/> <strong><field name="patient_id"/></strong>
                            </div>
                            <div class="text-muted small">
                                <i class="fa fa-camera me-1" title="Tindakan"/> <field name="test_id"/>
                            </div>
                            <div class="d-flex justify-content-between align-items-center mt-2 pt-1 border-top">
                                <field name="modality" widget="badge"
                                       decoration-primary="modality in ('xray', 'fluoro')"
                                       decoration-info="modality == 'usg'"
                                       decoration-warning="modality == 'ct'"
                                       decoration-success="modality == 'mri'"/>
                                <field name="state" widget="badge"
                                       decoration-info="state == 'draft'"
                                       decoration-warning="state == 'scheduled'"
                                       decoration-primary="state == 'examined'"
                                       decoration-success="state == 'verified'"
                                       decoration-muted="state == 'cancelled'"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Radiology Order List View -->
    <record id="view_health_radiology_order_list" model="ir.ui.view">
        <field name="name">health.radiology.order.list</field>
        <field name="model">health.radiology.order</field>
        <field name="arch" type="xml">
            <list string="Daftar Permintaan &amp; Hasil Radiologi" sample="1"
                  decoration-danger="priority == 'cito'"
                  decoration-success="state == 'verified'"
                  decoration-muted="state == 'cancelled'">
                <field name="name" decoration-bf="1"/>
                <field name="date"/>
                <field name="patient_id"/>
                <field name="medical_record_no"/>
                <field name="physician_id"/>
                <field name="test_id"/>
                <field name="modality" widget="badge"/>
                <field name="priority" widget="badge"
                       decoration-danger="priority == 'cito'"
                       decoration-info="priority == 'normal'"/>
                <field name="tariff"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'scheduled'"
                       decoration-primary="state == 'examined'"
                       decoration-success="state == 'verified'"
                       decoration-muted="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <!-- Radiology Order Form View -->
    <record id="view_health_radiology_order_form" model="ir.ui.view">
        <field name="name">health.radiology.order.form</field>
        <field name="model">health.radiology.order</field>
        <field name="arch" type="xml">
            <form string="Formulir Pemeriksaan &amp; Ekspertise Radiologi">
                <header>
                    <button name="action_schedule" string="Jadwalkan / Terbitkan Order" type="object"
                            class="oe_highlight btn-primary" invisible="state != 'draft'"/>
                    <button name="action_examined" string="Selesai Exposure (Kirim ke Sp.Rad)" type="object"
                            class="oe_highlight btn-warning" invisible="state != 'scheduled'"/>
                    <button name="action_verify_radiologist" string="Verifikasi &amp; Rilis (Sp.Rad)" type="object"
                            class="oe_highlight btn-success" invisible="state != 'examined'"/>
                    <button name="action_open_pacs_viewer" string="Buka PACS Viewer" type="object"
                            class="btn-outline-info" invisible="state == 'draft'"/>
                    <button name="action_cancel" string="Batalkan Order" type="object"
                            invisible="state in ('verified', 'cancelled')"
                            confirm="Batalkan permintaan radiologi ini?"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,scheduled,examined,verified"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object" name="action_open_pacs_viewer" icon="fa-television"
                                invisible="state == 'draft'">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Buka DICOM</span>
                                <span class="o_stat_text">PACS Web</span>
                            </div>
                        </button>
                    </div>

                    <div class="oe_title">
                        <label for="name" string="No. Order Radiologi"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                        <div class="d-flex align-items-center my-2">
                            <span class="fw-bold me-2">Prioritas:</span>
                            <field name="priority" widget="badge"
                                   decoration-danger="priority == 'cito'"
                                   decoration-info="priority == 'normal'"/>
                            <span class="fw-bold ms-3 me-2">Modalitas:</span>
                            <field name="modality" widget="badge"/>
                        </div>
                    </div>

                    <group>
                        <group name="patient_info" string="Identitas Pasien &amp; Asal Permintaan">
                            <field name="patient_id" readonly="state != 'draft'"/>
                            <field name="medical_record_no"/>
                            <field name="patient_age"/>
                            <field name="gender"/>
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="origin_type" readonly="state != 'draft'"/>
                            <field name="inpatient_stay_id" invisible="origin_type != 'inpatient'"/>
                            <field name="emergency_triage_id" invisible="origin_type != 'emergency'"/>
                        </group>
                        <group name="exam_details" string="Tindakan Radiologi &amp; Dokter">
                            <field name="physician_id" readonly="state != 'draft'"/>
                            <field name="test_id" readonly="state != 'draft'"/>
                            <field name="tariff"/>
                            <field name="radiographer_id" readonly="state == 'verified'"/>
                            <field name="radiologist_id" readonly="state == 'verified'"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>

                    <group string="Indikasi Klinis / Riwayat Penyakit &amp; Trauma">
                        <field name="clinical_indication" placeholder="Alasan rujukan foto, keluhan, durasi sakit, lokasi trauma..."/>
                    </group>

                    <notebook>
                        <page string="Ekspertise Radiologi (Bacaan Sp.Rad)" name="expertise">
                            <group>
                                <field name="technique" placeholder="Teknik dan posisi pemotretan..."/>
                            </group>
                            <group string="Deskripsi Temuan Radiologis">
                                <field name="findings" placeholder="Deskripsi sistematis organ, densitas, kontur, fraktur, lesi..." readonly="state == 'verified'"/>
                            </group>
                            <group string="Kesan &amp; Kesimpulan Diagnostik (Impression)">
                                <field name="impression" placeholder="Kesan utama foto radiologis..." readonly="state == 'verified'"/>
                            </group>
                            <group string="Saran / Rekomendasi Lanjutan">
                                <field name="recommendations" placeholder="Anjuran modalitas lanjutan (CT/MRI) atau pemeriksaan ulang..." readonly="state == 'verified'"/>
                            </group>
                        </page>

                        <page string="Citra Utama &amp; Metadata PACS" name="pacs">
                            <group>
                                <group string="Identitas PACS DICOM">
                                    <field name="accession_number" readonly="1"/>
                                    <field name="dicom_study_uid" readonly="state == 'verified'"/>
                                    <field name="pacs_web_url" widget="url" readonly="1"/>
                                </group>
                                <group string="Lampiran Citra Temuan Utama (Key Finding)">
                                    <field name="key_image" widget="image" class="oe_avatar" options="{'size': [250, 250]}"/>
                                    <field name="key_image_filename" invisible="1"/>
                                </group>
                            </group>
                        </page>

                        <page string="Data Teknis Radiografer (Exposure)" name="technical">
                            <group>
                                <group string="Parameter Pesawat Rontgen">
                                    <field name="examination_time" readonly="1"/>
                                    <field name="projection_notes"/>
                                    <field name="exposure_kvp"/>
                                    <field name="exposure_mas"/>
                                </group>
                                <group string="Penggunaan Zat Kontras">
                                    <field name="contrast_used" widget="boolean_toggle"/>
                                    <field name="contrast_notes" invisible="not contrast_used"/>
                                </group>
                            </group>
                        </page>

                        <page string="Otorisasi &amp; Tanda Tangan Sp.Rad" name="verification" invisible="state != 'verified'">
                            <group>
                                <field name="verification_qr_code" readonly="1"/>
                                <field name="verified_time" readonly="1"/>
                                <field name="radiologist_id" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Radiology Order Search View -->
    <record id="view_health_radiology_order_search" model="ir.ui.view">
        <field name="name">health.radiology.order.search</field>
        <field name="model">health.radiology.order</field>
        <field name="arch" type="xml">
            <search string="Cari Order Radiologi">
                <field name="name" string="No. Order"/>
                <field name="patient_id" string="Pasien" filter_domain="['|', ('patient_id.name', 'ilike', self), ('medical_record_no', 'ilike', self)]"/>
                <field name="accession_number" string="Accession No"/>
                <field name="physician_id"/>
                <field name="test_id"/>
                <separator/>
                <filter name="cito" string="🚨 Prioritas CITO" domain="[('priority', '=', 'cito')]"/>
                <filter name="scheduled" string="Menunggu Pemotretan" domain="[('state', '=', 'scheduled')]"/>
                <filter name="waiting_reading" string="Menunggu Bacaan Sp.Rad" domain="[('state', '=', 'examined')]"/>
                <filter name="verified" string="Hasil Sudah Rilis" domain="[('state', '=', 'verified')]"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_state" domain="[]" context="{'group_by': 'state'}"/>
                    <filter string="Modalitas" name="group_modality" domain="[]" context="{'group_by': 'modality'}"/>
                    <filter string="Prioritas" name="group_priority" domain="[]" context="{'group_by': 'priority'}"/>
                    <filter string="Dokter Pengirim" name="group_physician" domain="[]" context="{'group_by': 'physician_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Radiology Order Action -->
    <record id="action_health_radiology_order" model="ir.actions.act_window">
        <field name="name">Order &amp; Ekspertise Radiologi</field>
        <field name="res_model">health.radiology.order</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_cito': 0}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Penerbitan Permintaan Radiologi Baru
            </p>
            <p>
                Kelola jadwal foto rontgen, USG, CT-scan, dan pembuatan lembar ekspertise dokter spesialis radiologi.
            </p>
        </field>
    </record>
</odoo>
