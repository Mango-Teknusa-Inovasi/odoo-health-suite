<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Sequence for INA-CBG Claim Number -->
    <record id="seq_health_inacbg_claim" model="ir.sequence">
        <field name="name">INA-CBG Claim Sequence</field>
        <field name="code">health.inacbg.claim</field>
        <field name="prefix">CLM/%(year)s/%(month)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- Default Config for Kemenkes E-Klaim -->
    <record id="config_inacbg_default" model="health.inacbg.config">
        <field name="name">Kemenkes E-Klaim INA-CBG (RS)</field>
        <field name="server_url">http://127.0.0.1:80/eklaim/ws.php</field>
        <field name="hospital_code">3578014</field>
        <field name="coder_nik">3578012345670001</field>
        <field name="tariff_class">CS</field>
        <field name="mode">mock</field>
    </record>
</odoo>
