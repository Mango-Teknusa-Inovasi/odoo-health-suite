<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Procedure Tree View -->
    <record id="view_health_surgical_procedure_tree" model="ir.ui.view">
        <field name="name">health.surgical.procedure.list</field>
        <field name="model">health.surgical.procedure</field>
        <field name="arch" type="xml">
            <list string="Katalog Tindakan Operasi &amp; VK">
                <field name="code"/>
                <field name="name"/>
                <field name="category" widget="badge"/>
                <field name="icd9_id"/>
                <field name="estimated_duration_minutes"/>
                <field name="requires_anesthesia"/>
                <field name="requires_pediatrician"/>
                <field name="total_procedure_tariff" widget="monetary"/>
            </list>
        </field>
    </record>

    <!-- Procedure Form View -->
    <record id="view_health_surgical_procedure_form" model="ir.ui.view">
        <field name="name">health.surgical.procedure.form</field>
        <field name="model">health.surgical.procedure</field>
        <field name="arch" type="xml">
            <form string="Tindakan Bedah / Persalinan">
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Nama Prosedur Tindakan"/>
                        <h1>
                            <field name="name" placeholder="e.g. Sectio Caesarea / Apendektomi"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Klasifikasi &amp; Standar Klinis">
                            <field name="code"/>
                            <field name="category"/>
                            <field name="icd9_id"/>
                            <field name="estimated_duration_minutes"/>
                            <field name="requires_anesthesia"/>
                            <field name="requires_pediatrician"/>
                            <field name="active"/>
                        </group>
                        <group string="Komponen Tarif Paket Tindakan">
                            <field name="currency_id" invisible="1"/>
                            <field name="operator_fee" widget="monetary"/>
                            <field name="anesthesia_fee" widget="monetary" invisible="not requires_anesthesia"/>
                            <field name="room_rent_fee" widget="monetary"/>
                            <field name="consumables_fee" widget="monetary"/>
                            <div class="oe_subtotal_footer_separator oe_inline o_td_label">
                                <label for="total_procedure_tariff"/>
                            </div>
                            <field name="total_procedure_tariff" nolabel="1" class="oe_subtotal_footer_separator" widget="monetary"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_health_surgical_procedure" model="ir.actions.act_window">
        <field name="name">Katalog Tindakan Bedah &amp; VK</field>
        <field name="res_model">health.surgical.procedure</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Daftarkan paket tindakan pembedahan dan persalinan kebidanan.
            </p>
        </field>
    </record>
</odoo>
