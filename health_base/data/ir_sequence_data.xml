<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Patient Medical Record Number (MRN / No RM) Sequence -->
        <record id="seq_health_patient_mrn" model="ir.sequence">
            <field name="name">Patient Medical Record Number (No RM)</field>
            <field name="code">health.patient.mrn</field>
            <field name="prefix">RM/%(range_year)s%(range_month)s/</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="use_date_range">True</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
