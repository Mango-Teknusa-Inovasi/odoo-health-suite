<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Physician Kanban View -->
    <record id="view_health_physician_kanban" model="ir.ui.view">
        <field name="name">health.physician.kanban</field>
        <field name="model">health.physician</field>
        <field name="arch" type="xml">
            <kanban string="Physicians" sample="1">
                <field name="id"/>
                <field name="name"/>
                <field name="code"/>
                <field name="specialty_id"/>
                <field name="sip_no"/>
                <field name="phone"/>
                <field name="email"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_details d-flex flex-column justify-content-between">
                            <div>
                                <strong class="o_kanban_record_title oe_partner_heading"><field name="name"/></strong>
                                <div class="text-muted"><field name="specialty_id"/></div>
                                <div class="small text-secondary">SIP: <field name="sip_no"/></div>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left">
                                    <span class="badge rounded-pill text-bg-primary"><field name="code"/></span>
                                </div>
                                <div class="oe_kanban_bottom_right">
                                    <field name="phone" widget="phone"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Physician List View -->
    <record id="view_health_physician_list" model="ir.ui.view">
        <field name="name">health.physician.list</field>
        <field name="model">health.physician</field>
        <field name="arch" type="xml">
            <list string="Daftar Dokter / Nakes" sample="1">
                <field name="code" decoration-bf="1"/>
                <field name="name"/>
                <field name="specialty_id" widget="badge"/>
                <field name="sip_no"/>
                <field name="str_no"/>
                <field name="phone"/>
                <field name="default_fee_percentage" widget="percentage"/>
                <field name="ihs_practitioner_id" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Physician Form View -->
    <record id="view_health_physician_form" model="ir.ui.view">
        <field name="name">health.physician.form</field>
        <field name="model">health.physician</field>
        <field name="arch" type="xml">
            <form string="Doctor Profile">
                <sheet>
                    <div class="oe_button_box" name="button_box"/>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    
                    <div class="oe_title">
                        <label for="name" string="Nama Lengkap &amp; Gelar Dokter"/>
                        <h1>
                            <field name="name" placeholder="cth. dr. Hendra Wijaya, Sp.A" required="1"/>
                        </h1>
                        <h3>
                            <span class="text-muted">Kode Dokter: </span>
                            <field name="code" placeholder="DR01" class="text-primary"/>
                        </h3>
                    </div>

                    <group>
                        <group string="Kualifikasi &amp; Legalitas">
                            <field name="specialty_id"/>
                            <field name="sip_no" placeholder="Nomor Surat Izin Praktik"/>
                            <field name="str_no" placeholder="Nomor Surat Tanda Registrasi"/>
                            <field name="department_ids" widget="many2many_tags" placeholder="Pilih poliklinik / unit tugas..."/>
                        </group>
                        <group string="Kontak &amp; Keuangan">
                            <field name="phone" widget="phone"/>
                            <field name="mobile" widget="phone"/>
                            <field name="email" widget="email"/>
                            <field name="default_fee_percentage"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>

                    <group string="Bridging &amp; Kepatuhan Regulasi">
                        <group>
                            <field name="ihs_practitioner_id" placeholder="UUID Practitioner Kemenkes SatuSehat"/>
                            <field name="bpjs_doctor_code" placeholder="Kode Dokter BPJS"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Physician Action Window -->
    <record id="action_health_physician" model="ir.actions.act_window">
        <field name="name">Dokter &amp; Tenaga Medis</field>
        <field name="res_model">health.physician</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Tambahkan profil dokter atau tenaga medis praktisi!
            </p>
        </field>
    </record>
</odoo>
