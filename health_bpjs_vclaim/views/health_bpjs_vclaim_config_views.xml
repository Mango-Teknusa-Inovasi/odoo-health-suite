<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_health_bpjs_vclaim_config_form" model="ir.ui.view">
        <field name="name">health.bpjs.vclaim.config.form</field>
        <field name="model">health.bpjs.vclaim.config</field>
        <field name="arch" type="xml">
            <form string="Konfigurasi BPJS VClaim 2.0">
                <header>
                    <button name="action_test_connection" string="Uji Koneksi Gateway" type="object" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Nama Konfigurasi"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Kredensial Resmi BPJS Kesehatan">
                            <field name="cons_id"/>
                            <field name="secret_key" password="True"/>
                            <field name="user_key" password="True"/>
                            <field name="ppk_code"/>
                        </group>
                        <group string="Parameter Gateway &amp; Server">
                            <field name="environment"/>
                            <field name="mode"/>
                            <field name="base_url"/>
                            <field name="active"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_health_bpjs_vclaim_config" model="ir.actions.act_window">
        <field name="name">Konfigurasi BPJS VClaim 2.0</field>
        <field name="res_model">health.bpjs.vclaim.config</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
