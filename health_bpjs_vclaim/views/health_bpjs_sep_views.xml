<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- SEP Tree View -->
    <record id="view_health_bpjs_sep_tree" model="ir.ui.view">
        <field name="name">health.bpjs.sep.list</field>
        <field name="model">health.bpjs.sep</field>
        <field name="arch" type="xml">
            <list string="Daftar Surat Eligibilitas Peserta (SEP)" decoration-success="state == 'published'" decoration-danger="state == 'cancelled'" decoration-muted="state == 'draft'">
                <field name="name"/>
                <field name="patient_id"/>
                <field name="no_kartu"/>
                <field name="jenis_pelayanan" widget="badge"/>
                <field name="tgl_sep"/>
                <field name="poli_tujuan_id"/>
                <field name="dpjp_id"/>
                <field name="diagnosa_awal_id"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <!-- SEP Form View -->
    <record id="view_health_bpjs_sep_form" model="ir.ui.view">
        <field name="name">health.bpjs.sep.form</field>
        <field name="model">health.bpjs.sep</field>
        <field name="arch" type="xml">
            <form string="Surat Eligibilitas Peserta (SEP)">
                <header>
                    <button name="action_generate_sep" string="Terbitkan SEP (VClaim)" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_print_sep" string="Cetak Lembar SEP" type="object" class="btn-secondary" invisible="state != 'published'"/>
                    <button name="action_cancel_sep" string="Batalkan SEP" type="object" class="btn-danger" invisible="state != 'published'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,published"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <span class="o_form_label" string="Nomor Surat Eligibilitas Peserta"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Data Pasien &amp; Kepesertaan JKN">
                            <field name="patient_id"/>
                            <field name="no_kartu"/>
                            <field name="nik"/>
                            <field name="patient_mrn"/>
                            <field name="patient_gender"/>
                            <field name="patient_age"/>
                            <field name="kelas_rawat"/>
                            <field name="peserta_jenis"/>
                        </group>
                        <group string="Pelayanan &amp; Rujukan">
                            <field name="jenis_pelayanan" widget="radio"/>
                            <field name="tgl_sep"/>
                            <field name="asal_rujukan"/>
                            <field name="no_rujukan"/>
                            <field name="ppk_rujukan"/>
                            <field name="inpatient_stay_id" invisible="jenis_pelayanan != '1'"/>
                            <field name="no_surat_kontrol"/>
                        </group>
                    </group>
                    <group string="Tujuan Poliklinik &amp; Medis">
                        <group>
                            <field name="poli_tujuan_id" invisible="jenis_pelayanan != '2'"/>
                            <field name="poli_eksekutif" invisible="jenis_pelayanan != '2'"/>
                            <field name="dpjp_id"/>
                        </group>
                        <group>
                            <field name="diagnosa_awal_id"/>
                            <field name="catatan"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_health_bpjs_sep" model="ir.actions.act_window">
        <field name="name">Surat Eligibilitas Peserta (SEP)</field>
        <field name="res_model">health.bpjs.sep</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Terbitkan SEP Rawat Jalan atau Rawat Inap via BPJS VClaim 2.0.
            </p>
        </field>
    </record>
</odoo>
