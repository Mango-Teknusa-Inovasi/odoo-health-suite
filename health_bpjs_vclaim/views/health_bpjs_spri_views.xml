<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_health_bpjs_spri_tree" model="ir.ui.view">
        <field name="name">health.bpjs.spri.list</field>
        <field name="model">health.bpjs.spri</field>
        <field name="arch" type="xml">
            <list string="Daftar SPRI Rawat Inap">
                <field name="name"/>
                <field name="patient_id"/>
                <field name="no_kartu"/>
                <field name="tgl_rencana_inap"/>
                <field name="dpjp_id"/>
                <field name="department_id"/>
                <field name="diagnosa_id"/>
                <field name="state" widget="badge" decoration-success="state == 'approved'"/>
            </list>
        </field>
    </record>

    <record id="view_health_bpjs_spri_form" model="ir.ui.view">
        <field name="name">health.bpjs.spri.form</field>
        <field name="model">health.bpjs.spri</field>
        <field name="arch" type="xml">
            <form string="Surat Perintah Rawat Inap (SPRI)">
                <header>
                    <button name="action_approve" string="Setujui &amp; Terbitkan SPRI" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_cancel" string="Batalkan SPRI" type="object" invisible="state == 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,approved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h2>Surat Perintah Rawat Inap (SPRI)</h2>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Pasien">
                            <field name="patient_id"/>
                            <field name="patient_mrn"/>
                            <field name="no_kartu"/>
                        </group>
                        <group string="Rencana Inap &amp; DPJP">
                            <field name="tgl_rencana_inap"/>
                            <field name="dpjp_id"/>
                            <field name="department_id"/>
                            <field name="diagnosa_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_health_bpjs_spri" model="ir.actions.act_window">
        <field name="name">SPRI Rawat Inap</field>
        <field name="res_model">health.bpjs.spri</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
