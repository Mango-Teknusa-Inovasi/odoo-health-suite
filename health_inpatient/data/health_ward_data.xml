        <!-- Wards / Pavilions -->
        <record id="ward_melati" model="health.ward">
            <field name="name">Bangsal Melati (Perawatan Umum)</field>
            <field name="code">MELATI</field>
            <field name="building">Gedung Rawat Inap Barat</field>
            <field name="floor">Lantai 1</field>
            <field name="nurse_station">Nurse Station Melati</field>
        </record>

        <record id="ward_mawar" model="health.ward">
