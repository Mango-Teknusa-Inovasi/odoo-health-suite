<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- SOAP Consultation List View -->
    <record id="view_health_emr_soap_list" model="ir.ui.view">
        <field name="name">health.emr.soap.list</field>
        <field name="model">health.emr.soap</field>
        <field name="arch" type="xml">
            <list string="Catatan Konsultasi Medis (SOAP)" sample="1">
                <field name="name" decoration-bf="1"/>
                <field name="examination_date"/>
                <field name="patient_id"/>
                <field name="chief_complaint"/>
                <field name="physician_id"/>
                <field name="department_id"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'done'"
                       decoration-muted="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <!-- SOAP Consultation Form View -->
    <record id="view_health_emr_soap_form" model="ir.ui.view">
        <field name="name">health.emr.soap.form</field>
        <field name="model">health.emr.soap</field>
        <field name="arch" type="xml">
            <form string="Konsultasi Klinis SOAP">
                <header>
                    <button name="action_validate" string="Selesai &amp; Validasi" type="object" class="oe_highlight" invisible="state == 'done'"/>
                    <button name="action_set_draft" string="Kembalikan ke Draft" type="object" invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Nomor Rekam Konsultasi"/>
                        <h1>
                            <field name="name" readonly="1" class="text-primary"/>
                        </h1>
                        <label for="chief_complaint" string="Keluhan Utama"/>
                        <h2>
                            <field name="chief_complaint" placeholder="cth. Demam tinggi 3 hari, batuk berdahak..." readonly="state == 'done'"/>
                        </h2>
                    </div>

                    <group>
                        <group string="Pasien &amp; Lokasi Layanan">
                            <field name="patient_id" readonly="state == 'done'"/>
                            <field name="department_id" readonly="state == 'done'"/>
                            <field name="examination_date" readonly="state == 'done'"/>
                        </group>
                        <group string="Dokter Pemeriksa">
                            <field name="physician_id" readonly="state == 'done'"/>
                            <field name="vital_sign_id" readonly="state == 'done'"
                                   domain="[('patient_id', '=', patient_id)]"
                                   placeholder="Pilih hasil TTV terkait..."/>
                            <field name="company_id" groups="base.group_multi_company" invisible="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Rekam Medis SOAP" name="soap_notes">
                            <group string="S - Subjective (Keluhan &amp; Anamnesis Pasien)">
                                <field name="subjective" nolabel="1" readonly="state == 'done'"/>
                            </group>
                            <group string="O - Objective (Hasil Pemeriksaan Fisik &amp; TTV)">
                                <field name="objective" nolabel="1" readonly="state == 'done'"/>
                            </group>
                            <group string="A - Assessment (Analisis &amp; Diagnosa Klinis)">
                                <field name="assessment" nolabel="1" readonly="state == 'done'"/>
                            </group>

                            <field name="diagnosis_line_ids" readonly="state == 'done'">
                                <list editable="bottom" string="Diagnosa ICD-10">
                                    <field name="diagnosis_id" options="{'no_create': True}"/>
                                    <field name="diagnosis_type" widget="badge"
                                           decoration-danger="diagnosis_type == 'primary'"
                                           decoration-info="diagnosis_type == 'secondary'"/>
                                    <field name="clinical_notes" placeholder="Catatan klinis spesifik..."/>
                                </list>
                            </field>

                            <group string="P - Plan (Instruksi Terapi, Resep &amp; Edukasi Pasien)" class="mt-3">
                                <field name="plan" nolabel="1" readonly="state == 'done'"/>
                            </group>
                        </page>

                        <page string="Surat Keterangan Medis" name="medical_certificates">
                            <group string="Surat Keterangan Istirahat Sakit">
                                <group>
                                    <field name="sick_leave_days" readonly="state == 'done'"/>
                                    <field name="sick_leave_start_date" readonly="state == 'done'"/>
                                    <field name="sick_leave_end_date" readonly="state == 'done'"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>

                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- SOAP Consultation Search View -->
    <record id="view_health_emr_soap_search" model="ir.ui.view">
        <field name="name">health.emr.soap.search</field>
        <field name="model">health.emr.soap</field>
        <field name="arch" type="xml">
            <search string="Cari Konsultasi SOAP">
                <field name="name"/>
                <field name="patient_id"/>
                <field name="physician_id"/>
                <field name="chief_complaint"/>
                <separator/>
                <filter string="Dalam Pemeriksaan (Draft)" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Selesai (Done)" name="filter_done" domain="[('state', '=', 'done')]"/>
                <group expand="0" string="Group By">
                    <filter string="Pasien" name="group_patient" context="{'group_by': 'patient_id'}"/>
                    <filter string="Dokter Pemeriksa" name="group_physician" context="{'group_by': 'physician_id'}"/>
                    <filter string="Poliklinik" name="group_department" context="{'group_by': 'department_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- SOAP Consultation Action Window -->
    <record id="action_health_emr_soap" model="ir.actions.act_window">
        <field name="name">Rekam Medis (SOAP)</field>
        <field name="res_model">health.emr.soap</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_health_emr_soap_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Mulai sesi konsultasi medis &amp; pencatatan SOAP pasien baru!
            </p>
        </field>
    </record>
</odoo>
