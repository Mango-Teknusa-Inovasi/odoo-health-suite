<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_move_form_health_billing" model="ir.ui.view">
        <field name="name">account.move.form.health.billing</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="health_billing_id" readonly="1" invisible="not health_billing_id"/>
            </xpath>
        </field>
    </record>
</odoo>
